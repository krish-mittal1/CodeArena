FROM ghcr.io/astral-sh/uv:python3.14-alpine

WORKDIR /app

RUN apk add --no-cache docker-cli

# Copy lockfiles from backend/ and install dependencies
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync

# Copy the backend source
COPY backend/ ./backend/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync

# Failsafe: Ensure groq is installed even if uv sync has lock issues
RUN uv pip install groq

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

# Single worker required: WebSocket connections + matchmaking state are in-memory
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
