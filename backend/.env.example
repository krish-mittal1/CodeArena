# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/codearena

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Match Settings
MATCH_DURATION_SECONDS=900
MATCHMAKING_POLL_INTERVAL_MS=500
MATCHMAKING_ELO_INITIAL_WINDOW=100
MATCHMAKING_ELO_MAX_WINDOW=500
MATCHMAKING_ELO_EXPAND_INTERVAL_SECONDS=30
MATCHMAKING_ELO_EXPAND_STEP=100

# Execution Sandbox
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_QUOTA=50000
SANDBOX_CPU_PERIOD=100000
SANDBOX_PIDS_LIMIT=64
SANDBOX_COMPILE_TIMEOUT=15
SANDBOX_RUN_TIMEOUT_DEFAULT=5
SANDBOX_TOTAL_TIMEOUT=60

# App
APP_NAME=CodeArena
DEBUG=false
