# Database
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/codearena
# Used by docker-compose.backend.yml for the Postgres service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=codexarena

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Match Settings
MATCH_DURATION_SECONDS=900
MATCHMAKING_POLL_INTERVAL_MS=500
MATCHMAKING_ELO_INITIAL_WINDOW=100
MATCHMAKING_ELO_MAX_WINDOW=500
MATCHMAKING_ELO_EXPAND_INTERVAL_SECONDS=30
MATCHMAKING_ELO_EXPAND_STEP=100

# Execution Sandbox
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_QUOTA=50000
SANDBOX_CPU_PERIOD=100000
SANDBOX_PIDS_LIMIT=64
SANDBOX_COMPILE_TIMEOUT=15
SANDBOX_RUN_TIMEOUT_DEFAULT=5
SANDBOX_TOTAL_TIMEOUT=60
SANDBOX_MAX_CONCURRENT=8
SANDBOX_ACQUIRE_TIMEOUT_SECONDS=30

# App
APP_NAME=CodeArena
DEBUG=false

# OTP / Resend
RESEND_API_KEY=re_your_api_key
OTP_FROM_EMAIL=CodeArena <noreply@codearena.com>

# Reverse proxy / client IP (OTP, auth, room-code rate limits)
# Behind pangolin/caddy this MUST be true: without it every visitor shares the
# proxy's IP and OTP/login rate limits are exhausted platform-wide by any
# single actor. Only set false if the app is exposed directly.
TRUST_FORWARDED_HEADERS=true
# Comma-separated IPs or CIDRs of trusted proxies. XFF is honoured only if
# request.client.host is in this list; client IP = rightmost hop that is NOT
# trusted. The default matches the compose network in docker-compose.backend.yml
# (docker default pool 172.16.0.0/12 — override if your networks differ).
TRUSTED_PROXIES=172.20.0.0/16

# Host port the API container publishes (docker-compose.backend.yml).
# Keep this firewalled; route public traffic through pangolin → http://api:8000.
API_HOST_PORT=8000
